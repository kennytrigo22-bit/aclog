# Modele de configuration PRODUCTION (cabinet-aclog.com) - a copier en .env sur le serveur, jamais dans le depot.
APP_NAME="CABINET ACLOG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cabinet-aclog.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions et cookies : HTTPS obligatoire
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mails (necessaire : verification de compte, reinitialisation du mot de passe, contact)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@cabinet-aclog.com
MAIL_FROM_NAME="${APP_NAME}"

# IA (import de contenus)
GEMINI_API_KEY=

# Derriere Cloudflare : plages IP de Cloudflare (verifier la liste a jour sur https://www.cloudflare.com/ips/).
# Sans reverse proxy, laisser vide. Ne jamais mettre "*" en production.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# Apres chaque mise en ligne :
#   composer install --no-dev --optimize-autoloader
#   npm ci && npm run build   (puis supprimer public/hot s'il existe)
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan optimize
